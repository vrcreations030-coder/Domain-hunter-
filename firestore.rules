rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedDomain(data, userId, bookmarkId) {
      return data.keys().hasAll(['id', 'domain', 'status', 'userId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'domain', 'status', 'price', 'notes', 'userId', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == bookmarkId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.domain is string
        && data.domain.size() >= 4
        && data.domain.size() <= 253
        && data.domain.matches('^[a-z0-9.-]+\\.[a-z]{2,}$')
        && data.status is string
        && data.status in ['available', 'taken', 'premium', 'hack', 'unknown']
        && (!('price' in data) || data.price == null || (data.price is string && data.price.size() <= 32))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSearchHistory(data, userId, historyId) {
      return data.keys().hasAll(['id', 'query', 'mode', 'userId', 'createdAt'])
        && data.keys().hasOnly(['id', 'query', 'mode', 'userId', 'createdAt'])
        && data.id is string
        && data.id == historyId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.query is string
        && data.query.size() >= 1
        && data.query.size() <= 120
        && data.mode is string
        && data.mode in ['search', 'extensions', 'generator', 'premium', 'research']
        && data.createdAt is timestamp;
    }

    function isValidDomainAlert(data, userId, alertId) {
      return data.keys().hasAll(['id', 'domain', 'userId', 'email', 'channel', 'trigger', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'domain', 'userId', 'email', 'channel', 'trigger', 'expiresAt', 'maxPriceUsd', 'active', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == alertId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.domain is string
        && data.domain.size() >= 4
        && data.domain.size() <= 253
        && data.domain.matches('^[a-z0-9.-]+\\.[a-z]{2,}$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.email == request.auth.token.email
        && data.channel is string
        && data.channel in ['email', 'browser', 'both']
        && data.trigger is string
        && data.trigger in ['expires_or_available', 'available', 'expiring', 'price_below_budget']
        && (!('expiresAt' in data) || data.expiresAt == null || (data.expiresAt is string && data.expiresAt.size() <= 64))
        && (!('maxPriceUsd' in data) || data.maxPriceUsd == null || (data.maxPriceUsd is number && data.maxPriceUsd >= 1 && data.maxPriceUsd <= 10000000))
        && (data.trigger != 'price_below_budget' || (('maxPriceUsd' in data) && data.maxPriceUsd is number && data.maxPriceUsd >= 1 && data.maxPriceUsd <= 10000000))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /bookmarks/{bookmarkId} {
        allow get: if isValidId(userId) && isValidId(bookmarkId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(bookmarkId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSavedDomain(incoming(), userId, bookmarkId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(bookmarkId)
          && isOwner(userId)
          && isValidSavedDomain(incoming(), userId, bookmarkId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'price', 'notes', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(bookmarkId) && isOwner(userId);
      }

      match /searchHistory/{historyId} {
        allow get: if isValidId(userId) && isValidId(historyId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(historyId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSearchHistory(incoming(), userId, historyId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(historyId) && isOwner(userId);
      }

      match /domainAlerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(alertId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidDomainAlert(incoming(), userId, alertId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(alertId)
          && isOwner(userId)
          && isValidDomainAlert(incoming(), userId, alertId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().domain == existing().domain
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['channel', 'trigger', 'expiresAt', 'maxPriceUsd', 'active', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(alertId) && isOwner(userId);
      }
    }
  }
}
