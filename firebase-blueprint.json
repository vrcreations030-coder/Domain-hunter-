{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile for Domain Hunter.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "SavedDomain": {
      "title": "SavedDomain",
      "description": "A domain bookmarked or watchlisted by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sanitized bookmark identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "domain": {
          "type": "string",
          "description": "Lowercase domain name",
          "minLength": 4,
          "maxLength": 253,
          "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
        },
        "status": {
          "type": "string",
          "description": "Last observed domain status",
          "enum": ["available", "taken", "premium", "hack", "unknown"]
        },
        "price": {
          "type": "string",
          "description": "Observed registrar or aftermarket price",
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "description": "Optional user notes",
          "maxLength": 300
        },
        "userId": {
          "type": "string",
          "description": "Owner UID matching request.auth.uid",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["id", "domain", "status", "userId", "createdAt", "updatedAt"]
    },
    "SearchHistoryEntry": {
      "title": "SearchHistoryEntry",
      "description": "Recent domain search query saved for the signed-in user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sanitized history entry identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "query": {
          "type": "string",
          "description": "Search label or idea",
          "minLength": 1,
          "maxLength": 120
        },
        "mode": {
          "type": "string",
          "description": "Search mode used",
          "enum": ["search", "extensions", "generator", "premium", "research"]
        },
        "userId": {
          "type": "string",
          "description": "Owner UID matching request.auth.uid",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["id", "query", "mode", "userId", "createdAt"]
    },
    "DomainAlert": {
      "title": "DomainAlert",
      "description": "Domain availability and expiration alert subscription for an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sanitized alert identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "domain": {
          "type": "string",
          "description": "Lowercase domain name being monitored",
          "minLength": 4,
          "maxLength": 253,
          "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID matching request.auth.uid",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified account email address for alert delivery",
          "minLength": 3,
          "maxLength": 160
        },
        "channel": {
          "type": "string",
          "description": "Notification delivery mechanism",
          "enum": ["email", "browser", "both"]
        },
        "trigger": {
          "type": "string",
          "description": "Condition that fires the notification",
          "enum": ["expires_or_available", "available", "expiring", "price_below_budget"]
        },
        "expiresAt": {
          "type": "string",
          "description": "Observed RDAP expiration ISO timestamp if known",
          "maxLength": 64
        },
        "maxPriceUsd": {
          "type": "number",
          "description": "Optional maximum price threshold in USD for premium domain alerts"
        },
        "active": {
          "type": "boolean",
          "description": "Whether monitoring is currently active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["id", "domain", "userId", "email", "channel", "trigger", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile owned strictly by userId."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/SavedDomain" },
      "description": "User's saved domains and watchlist entries."
    },
    "/users/{userId}/searchHistory/{historyId}": {
      "schema": { "$ref": "#/entities/SearchHistoryEntry" },
      "description": "User's recent search queries synced across devices."
    },
    "/users/{userId}/domainAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/DomainAlert" },
      "description": "User's active domain availability and expiration alerts."
    }
  }
}
